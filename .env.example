# ──────────────────────────────────────────────────────────────
#  IDEA_MECE 환경 변수 예시  (이 파일을 .env 로 복사해서 사용)
#  ※ .env 파일은 절대 깃허브에 커밋하지 마세요 (.gitignore 처리됨)
# ──────────────────────────────────────────────────────────────

# [필수] Flask 세션 서명 키 — 반드시 랜덤 문자열로 교체
# 생성 예시: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=여기에_랜덤한_긴_문자열을_넣으세요

# [선택] 운영 모드 (production | development)
FLASK_ENV=production

# [선택] HTTPS 전용 쿠키 사용 여부 (배포 시 1 권장, 로컬 http 테스트 시 0)
SESSION_COOKIE_SECURE=1

# [선택] SQLite 데이터베이스 경로
DATABASE_PATH=instance/idea_mece.sqlite3

# [선택] 한 번의 요청으로 생성 가능한 하위 아이디어 최대 개수
MAX_CHILDREN_PER_REQUEST=10

# [선택] 프로젝트 1건당 최대 노드 수 (메모리/비용 보호)
MAX_NODES_PER_PROJECT=2000

# [선택] 트리 최대 깊이 (실사용상 무제한에 가까운 값)
MAX_TREE_DEPTH=100

# [선택] 세션에 보관되는 API 키의 유효시간(초) — 기본 2시간
API_KEY_TTL_SECONDS=7200

# [선택] 생성된 워드 파일 보관 시간(초) — 기본 1시간 후 자동 삭제
DOWNLOAD_TTL_SECONDS=3600

# ※ Gemini API 키는 여기에 넣지 않습니다.
#    보안 설계상 키는 서버에 저장하지 않고, 사용자가 웹 화면의 [설정] 모달에서
#    직접 입력하여 본인 브라우저 세션에만 격리 보관됩니다.
